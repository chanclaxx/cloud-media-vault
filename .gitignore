# ============================================================
#  .gitignore — Cloud Media Vault
#  Requisito del profesor: NO subir node_modules ni .env reales.
# ============================================================

# Dependencias
node_modules/

# Variables de entorno con credenciales reales (NUNCA se suben)
.env
.env.*
!.env.example

# Builds
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Red de seguridad: carpetas de pruebas/experimentos.
# Las pruebas se hacen FUERA del repo (ver CLAUDE.md), pero si alguien
# se equivoca, esto evita que terminen en GitHub.
_pruebas/
pruebas/
scratch/
tmp/
temp/
uploads/
muestras/

# Archivos multimedia sueltos de prueba (el repo no guarda multimedia:
# los archivos viven en Cloudinary)
*.mp4
*.mov
*.webm
*.pdf

# Sistema operativo / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Configuración local de Claude Code (personal de cada integrante)
.claude/settings.local.json
CLAUDE.local.md
