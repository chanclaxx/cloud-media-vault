# ============================================================
#  server/.env.example
#  1. Copia este archivo como  server/.env   (cp .env.example .env)
#  2. Llena los valores reales (los comparte el Rol 1 por un canal PRIVADO).
#  3. NUNCA subas server/.env a GitHub (ya está en .gitignore).
# ============================================================

# Puerto de la API
PORT=4000

# Origen(es) permitidos por CORS (el frontend de Vite). Varios separados por coma.
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas -> Database -> Connect -> Drivers. Incluye el nombre de la BD antes del "?".
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/cloud_media_vault?retryWrites=true&w=majority

# Cloudinary -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu_api_secret

# Carpeta dentro de Cloudinary donde se guardan los archivos
CLOUDINARY_FOLDER=cloud-media-vault
